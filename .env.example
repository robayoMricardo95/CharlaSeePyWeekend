OPENAI_API_KEY=
ANTHROPIC_API_KEY=

TRAZAS=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Azure OpenAI. Si estas dos estan puestas, el agente usa Azure en vez de
# OpenAI directo. El endpoint termina en /openai/v1 (superficie compatible),
# asi que no hace falta api-version ni AzureChatOpenAI.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=

# Nombre del deployment en Azure AI Foundry (el que creaste en la consola)
AZURE_OPENAI_MODELO=

# Nombres de modelo para OpenAI directo y Claude (Anthropic)
OPENAI_MODELO=gpt-4.1
ANTHROPIC_MODELO=claude-sonnet-5-5
